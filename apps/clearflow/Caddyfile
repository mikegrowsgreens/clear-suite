:{$PORT}

root * /srv

header {
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy strict-origin-when-cross-origin
}

# Version-named third-party libs: contents can never change under a given
# filename, so cache hard. NOTE: deliberately no try_files here — a missing
# vendor file must return a real 404, never the HTML document. Caching HTML
# under a script URL for a year would brick the app.
handle /vendor/* {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# Load-bearing: this is the one header the service worker cannot fix itself.
handle /sw.js {
	header Cache-Control "no-cache"
	file_server
}

handle /manifest.json {
	header Cache-Control "no-cache"
	file_server
}

handle /icon-192.png /icon-512.png {
	header Cache-Control "public, max-age=604800"
	file_server
}

# Everything else resolves to the document. Always revalidate.
handle {
	header Cache-Control "no-cache"
	try_files {path} {path}/ /index.html
	file_server
}
